# Copy to scripts/desktop/sign.env, fill in, and `source` it before a release build:
#
#   set -a; source scripts/desktop/sign.env; set +a
#   pnpm desktop:build
#
# sign.env is gitignored. Never commit real values.

# ── Code signing ─────────────────────────────────────────────────────────────
# Exact string from `security find-identity -v -p codesigning`
export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# ── Notarization — App Store Connect API key (preferred) ──────────────────────
# From https://appstoreconnect.apple.com/access/integrations/api (Developer role)
export APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
export APPLE_API_KEY="XXXXXXXXXX"                       # the Key ID
export APPLE_API_KEY_PATH="$HOME/.appstoreconnect/AuthKey_XXXXXXXXXX.p8"

# ── Notarization — Apple ID (alternative; comment out the API-key block) ──────
# export APPLE_ID="you@example.com"
# export APPLE_PASSWORD="abcd-efgh-ijkl-mnop"           # app-specific password
# export APPLE_TEAM_ID="TEAMID"
